# ─── API ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Mock mode ────────────────────────────────────────────
# "true" (default) serves in-memory fixtures so the UI runs without a backend.
# Set to "false" to hit the real API at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCK=true

# ─── GitHub OAuth (same Client ID as backend GITHUB_CLIENT_ID) ─
NEXT_PUBLIC_GITHUB_CLIENT_ID=
