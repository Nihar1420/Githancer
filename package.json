{
  "name": "githancer",
  "version": "1.0.0",
  "private": true,
  "description": "Git Timeline Manager — schedule and backdate commits across a timeline",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --if-present dev",
    "build": "pnpm --filter \"./packages/*\" --if-present build && pnpm --filter \"./apps/*\" --if-present build",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.4.5"
  }
}
